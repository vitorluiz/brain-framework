# Variáveis de ambiente para docker-compose.yml
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o .env real no Git.

# PostgreSQL (obrigatório se usar o serviço postgres)
POSTGRES_USER=brain
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=brain

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Banco de dados (string de conexão completa)
# Formato: postgresql+psycopg://usuario:senha@host:porta/banco
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Opcional: Brain Framework
# BRAIN_ROOT=/caminho/para/dados
# BRAIN_SIGNING_KEY=  # chave privada Ed25519 (base64) — gerada automaticamente se ausente
# BRAIN_SIGNING_KEY_PUB=  # chave pública Ed25519 (base64) — gerada automaticamente se ausente

# Opcional: Dashboard
# BRAIN_DASHBOARD_SECRET=  # secret para cookies (gerado automaticamente se ausente)
# BRAIN_DASHBOARD_TOKEN=   # token de acesso single-admin (gerado automaticamente se ausente)
# BRAIN_DASHBOARD_HOST=127.0.0.1
# BRAIN_DASHBOARD_PORT=8611
# BRAIN_DASHBOARD_MAX_UPLOAD=52428800
# BRAIN_DASHBOARD_SECURE_COOKIES=false

# Opcional: Learn por URL
# BRAIN_DASHBOARD_ALLOW_PRIVATE_URLS=false
# BRAIN_DASHBOARD_URL_TIMEOUT=15
# BRAIN_DASHBOARD_MAX_URL_BYTES=10485760